# ==============================================================================
# Antigravity Multi-Agent Trading System Configuration
# ==============================================================================

# Application Settings
APP_NAME="Antigravity Multi-Agent Trading System"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM Intelligence Providers
LLM_PROVIDER=antigravity                 # "antigravity", "gemini", or "openai"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# Trading Scheme & Execution Mode
# ==============================================================================
# TRADING_MODE: Set to "PAPER" for simulation, or "LIVE" for real-money execution
TRADING_MODE=PAPER

# Safety Interlock: Must be explicitly set to 'true' to permit real-money orders
LIVE_TRADING_ENABLED=false

# Full Budget Utilization Mode:
# When 'true', the bot dynamically allocates the entire available capital across
# remaining open position slots (available_cash / remaining_slots), rather than
# hoarding 80%+ cash. Ideal when you maintain cash reserves externally on the side.
FULL_BUDGET_UTILIZATION=true

# Broker Selection: "ibkr" (Interactive Brokers), "trading212" or "alpaca"
LIVE_BROKER=ibkr

# Emergency Kill Switch (Immediately halts all trading and auto-orders)
KILL_SWITCH_ACTIVE=false

# Risk Limits
MAX_DAILY_LOSS_EUR=500.0                # Halts new buys if net daily loss exceeds €500
MAX_SINGLE_ORDER_EUR=2500.0             # Maximum EUR capital per single position
MAX_POSITIONS=8                         # Maximum concurrent open positions
CASH_FLOW_MIN_EUR=100.0                 # Broker cash jumps of at least this much that no trade explains count as deposit/withdrawal, not gain
DEFAULT_STOP_LOSS_PCT=0.04              # 4% baseline stop loss
DEFAULT_TAKE_PROFIT_PCT=0.08            # 8% baseline take profit (1:2 R:R)
MIN_CONSENSUS_SCORE=70                  # Minimum multi-agent consensus to auto-buy
TRIGGER_MIN_SCORE=80                    # Minimum score to arm AI price limit triggers
ENFORCE_MARKET_HOURS=true               # Strictly block execution when exchanges are closed

# ==============================================================================
# Shadow paper portfolios (simulation only, never sends orders)
# ==============================================================================
# Each shadow follows the same committee verdicts as the main bot with its own rules,
# so the Shadow tab can show whether other parameter values would have done better.
# Presets: aggressive, momentum, baseline (same rules as the main bot, as a control group).
# Unless a strategy sets its own value, a shadow uses the main bot's trigger threshold, breakeven %,
# max positions, RISK_PER_TRADE_PCT, TRAILING_STOP_ATR_MULT and REGIME_FILTER_ENABLED, frozen when it
# starts so the learner does not change the experiment halfway; reset a shadow to adopt new values.
# Shadows buy whole shares when WHOLE_SHARES_ONLY is on, like the main bot.
SHADOW_ENABLED=true
SHADOW_STRATEGIES=aggressive
# Starting cash per shadow; empty = INITIAL_PAPER_CAPITAL
SHADOW_INITIAL_CAPITAL=
# Optional own variants (JSON on one line), then add their key to SHADOW_STRATEGIES. Fields:
# score_offset, accept_hold, ignore_risk_veto, entry_mode (trigger|market), pullback_scale, stop_scale,
# reward_risk, use_take_profit, breakeven_pct, trailing_stop_pct, max_positions, max_hold_days,
# risk_per_trade_pct, trailing_atr_mult, regime_filter (true|false)
# SHADOW_CUSTOM_STRATEGIES={"tight": {"base": "aggressive", "stop_scale": 0.8, "label": "Tight stop"}}

# ==============================================================================
# Broker 1: Interactive Brokers (IBKR) - Recommended for EU & US Equities
# ==============================================================================
# Runs headlessly via IB Gateway or TWS.
# Default ports: 4001 = Live IB Gateway, 4002 = Paper IB Gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=U1234567

# ==============================================================================
# Broker 2: Trading 212 (EU & US Equities, fractional shares)
# ==============================================================================
# Invest account only. Create an API key in the Trading 212 app: Settings > API (Beta).
# Give it the account, portfolio, metadata, orders:read, orders:execute and history scopes.
# TRADING212_DEMO=true trades the practice account; set false for real money.
# WHOLE_SHARES_ONLY defaults to false for trading212 (fractional buys) and true for ibkr.
TRADING212_API_KEY=your_trading212_api_key_here
TRADING212_API_SECRET=your_trading212_api_secret_here
TRADING212_DEMO=true

# ==============================================================================
# Broker 3: Alpaca Markets (US Equities Only)
# ==============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://api.alpaca.markets
